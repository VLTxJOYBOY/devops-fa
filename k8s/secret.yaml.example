# ─── Example Kubernetes Secret ───────────────────────────────────────────────
# Copy this file to k8s/secret.yaml and fill in your base64-encoded or plain string values.
# DO NOT commit k8s/secret.yaml to version control.
# ─────────────────────────────────────────────────────────────────────────────
apiVersion: v1
kind: Secret
metadata:
  name: pulsecity-secrets
  namespace: pulsecity
  labels:
    app.kubernetes.io/name: pulsecity
type: Opaque
stringData:
  MONGO_URI: "mongodb+srv://<YOUR_MONGO_USERNAME>:<YOUR_MONGO_PASSWORD>@<YOUR_CLUSTER>.mongodb.net/<YOUR_DB_NAME>?retryWrites=true&w=majority"
  JWT_SECRET: "<YOUR_SECURE_JWT_SECRET>"
