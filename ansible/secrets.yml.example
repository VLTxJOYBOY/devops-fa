# ansible/secrets.yml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ansible/secrets.yml and fill in your real values.
# The actual secrets.yml is git-ignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────────────────────

mongo_uri: "mongodb+srv://<DB_USER>:<DB_PASSWORD>@<CLUSTER>.mongodb.net/pulsecity?retryWrites=true&w=majority"
ghcr_token: "<YOUR_GITHUB_PAT>"
jwt_secret: "<YOUR_JWT_SECRET>"
